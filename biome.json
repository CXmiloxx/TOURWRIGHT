{
  "files": { "includes": ["bin/**", "src/**", "test/**", "examples/**/*.js", "scripts/**/*.js"] },
  "formatter": { "enabled": false },
  "assist": { "enabled": false },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noUnusedVariables": { "level": "error", "options": { "ignoreRestSiblings": true } },
        "noUnusedImports": "error"
      },
      "suspicious": {
        "noThenProperty": "off",
        "noAssignInExpressions": "off",
        "useIterableCallbackReturn": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/render/network.js"],
      "linter": { "rules": { "correctness": { "noConstructorReturn": "off", "noUnreachableSuper": "off" } } }
    },
    {
      "includes": ["src/render/steps.js", "src/run-job.js"],
      "linter": { "rules": { "suspicious": { "noControlCharactersInRegex": "off" } } }
    },
    {
      "includes": ["test/**"],
      "linter": { "rules": { "suspicious": { "noTemplateCurlyInString": "off" } } }
    }
  ]
}

# ── API ──────────────────────────────────────────────────────────────────────────────
# Bearer tokens accepted by the API, comma-separated. Each token only sees its own jobs.
# Generate one: openssl rand -hex 24
TOURWRIGHT_API_TOKENS=
# Where the API is reachable from outside (download links in results and webhooks)
TOURWRIGHT_PUBLIC_URL=http://localhost:4700
# Docker: address:port published on the host (0.0.0.0:4700 to expose it; put TLS in front)
TOURWRIGHT_PUBLISH=127.0.0.1:4700
# Signs download links; same value on every API replica and worker (defaults to the tokens)
TOURWRIGHT_LINK_SECRET=
# Signs webhook bodies (header x-tourwright-signature: sha256=…)
TOURWRIGHT_WEBHOOK_SECRET=

# ── Workers ──────────────────────────────────────────────────────────────────────────
TOURWRIGHT_WORKERS=2
TOURWRIGHT_CONCURRENCY=1
TOURWRIGHT_WORKER_CPUS=2
TOURWRIGHT_WORKER_MEMORY=2g
TOURWRIGHT_FFMPEG_THREADS=2
# x264 preset of the final video (medium). veryfast on weak or virtual CPUs: faster, larger files
TOURWRIGHT_PRESET=
# Max seconds per video, attempts, and hours finished jobs are kept (0 = forever)
TOURWRIGHT_JOB_TIMEOUT=1800
TOURWRIGHT_JOB_ATTEMPTS=2
TOURWRIGHT_RETENTION_HOURS=72

# ── Network sandbox for API jobs ─────────────────────────────────────────────────────
# Hosts the browser may open (empty = any). Wildcards: *.example.com
TOURWRIGHT_ALLOWED_HOSTS=
# Block private networks and cloud metadata (recommended when clients are not fully trusted)
TOURWRIGHT_BLOCK_PRIVATE=true
# ${env:TOURWRIGHT_SECRET_*} in API jobs
TOURWRIGHT_ALLOW_SECRETS=false

# ── Voices ───────────────────────────────────────────────────────────────────────────
TOURWRIGHT_VOICE=piper:es_MX-claude-high
# OpenAI-compatible TTS server (OpenAI, Kokoro-FastAPI, LocalAI…)
TOURWRIGHT_OPENAI_TTS_URL=
TOURWRIGHT_OPENAI_TTS_KEY=

# ── Storage: S3-compatible (AWS, R2, B2, SeaweedFS…). Empty bucket = the shared data volume ──
# With `docker compose --profile s3`: TOURWRIGHT_S3_BUCKET=tourwright and the endpoint below
TOURWRIGHT_S3_BUCKET=
TOURWRIGHT_S3_ENDPOINT=http://s3:8333
# The address clients use to download (download links are signed for it)
TOURWRIGHT_S3_PUBLIC_ENDPOINT=http://127.0.0.1:8333
TOURWRIGHT_S3_REGION=us-east-1
TOURWRIGHT_S3_ACCESS_KEY=tourwright
TOURWRIGHT_S3_SECRET_KEY=change-me-please

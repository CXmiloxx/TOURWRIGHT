{
  "name": "tourwright",
  "version": "2.6.2",
  "mcpName": "io.github.CXmiloxx/tourwright",
  "description": "Scripted, narrated product tours and how-to videos: a real browser follows your script with a guided focus, captions and text-to-speech, and you get a finished MP4. CLI, HTTP API, job queue and MCP server for AI agents.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "tourwright": "bin/tourwright.js"
  },
  "files": [
    "bin",
    "src",
    "schema",
    "docs",
    "!docs/voices",
    "!docs/demo",
    "examples",
    "README.md",
    "README.es.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test",
    "lint": "biome lint",
    "typecheck": "tsc -p jsconfig.json",
    "check": "npm run lint && npm run typecheck && npm run architecture && npm test && node scripts/check-schema.js",
    "schema": "node bin/tourwright.js schema > schema/script.schema.json",
    "architecture": "node scripts/check-architecture.js"
  },
  "keywords": [
    "product-tour",
    "onboarding",
    "walkthrough",
    "tutorial",
    "demo-video",
    "video",
    "narration",
    "text-to-speech",
    "tts",
    "screencast",
    "playwright",
    "ffmpeg",
    "mcp",
    "ai-agents",
    "piper",
    "screen-recording",
    "video-generation",
    "documentation",
    "how-to",
    "user-onboarding",
    "demo",
    "automation",
    "claude-code",
    "model-context-protocol"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "playwright": "^1.64.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "bullmq": "^6.5.1",
    "ioredis": "^6.0.0"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/sdk": {
      "optional": true
    },
    "bullmq": {
      "optional": true
    },
    "ioredis": {
      "optional": true
    }
  },
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CXmiloxx/tourwright.git"
  },
  "homepage": "https://github.com/CXmiloxx/tourwright#readme",
  "bugs": {
    "url": "https://github.com/CXmiloxx/tourwright/issues"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@biomejs/biome": "^2.6.3",
    "@types/node": "^22.20.5",
    "bullmq": "^6.5.1",
    "ioredis": "^6.0.0",
    "typescript": "^7.0.2"
  },
  "imports": {
    "#core/*": "./src/core/*",
    "#script/*": "./src/script/*",
    "#render/*": "./src/render/*",
    "#video/*": "./src/video/*",
    "#voice/*": "./src/voice/*",
    "#ai/*": "./src/ai/*",
    "#authoring/*": "./src/authoring/*",
    "#install/*": "./src/install/*",
    "#plugins/*": "./src/plugins/*",
    "#server/*": "./src/server/*",
    "#cli/*": "./src/cli/*"
  }
}
